# Copy to .env (gitignored). `./run` loads it automatically.

# Directory the tools operate in (default: ~/RynsWorkspace)
# RYNS_WORKSPACE_ROOT=/path/to/workspace

# Externally reachable base URL, used for links returned by sheet_url and
# record_video (default: http://127.0.0.1:8799)
# RYNS_PUBLIC_BASE_URL=https://your-tunnel.example.com

# Bearer tokens accepted when serving over HTTP (-port N). Comma-separated;
# required for HTTP mode (the server refuses to start without it) and sent by
# clients as `Authorization: Bearer <token>` or `X-RYNS-Auth: <token>`
# (nothing is accepted via query parameters).
# Stdio mode never checks auth and ignores this variable.
# RYNS_AUTH_TOKEN=<your-token>
