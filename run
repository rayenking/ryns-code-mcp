#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Optional local config (gitignored): RYNS_WORKSPACE_ROOT, RYNS_PUBLIC_BASE_URL, ...
if [[ -f "$ROOT/.env" ]]; then set -a; . "$ROOT/.env"; set +a; fi

DEFAULT_WORKSPACE="${HOME}/RynsWorkspace"
WORKSPACE="${RYNS_WORKSPACE_ROOT:-$DEFAULT_WORKSPACE}"
STATE_DIR="$ROOT/.state"
ENABLED_FILE="$STATE_DIR/enabled"
PID_FILE="$STATE_DIR/pid"
STATUS_FILE="$STATE_DIR/status"
PACKAGE_JSON="$ROOT/package.json"
RUST_DIR="$ROOT/ryns-code-mcp-rs"
RUST_RELEASE_BIN="$RUST_DIR/target/release/ryns-code-mcp"
RUST_DEBUG_BIN="$RUST_DIR/target/debug/ryns-code-mcp"
LEGACY_GO_DIR="$ROOT/legacy-go"
LEGACY_GO_ENTRYPOINT="$LEGACY_GO_DIR/main.go"
GO_BINARY="$STATE_DIR/ryns-go-legacy"

log() {
  printf '[ryns-code-mcp] %s\n' "$*" >&2
}

usage() {
  cat <<'EOF'
Usage: ./run [options]

Commands:
  ./run                 Run the existing MCP over stdio (default)
  ./run --enable        Mark MCP as enabled; do not start a daemon
  ./run --disable       Mark MCP as disabled and stop a managed process, if any
  ./run --status        Show enabled state, process state, version and paths
  ./run --restart       Restart a managed/background process, if one exists
  ./run --port PORT     Serve MCP over Streamable HTTP on 127.0.0.1:PORT
                        (for cloudflared tunnel or other HTTP clients);
                        defaults to stdio
  ./run --version       Show MCP version (Rust crate version)
  ./run --help          Show this help

Options:
  --workspace PATH      Workspace root (also supported by RYNS_WORKSPACE_ROOT)
  -go                   Escape hatch: run the legacy Go server
                        (legacy-go/, built into .state/ryns-go-legacy)

Environment:
  RYNS_WORKSPACE_ROOT   Override the default workspace:
                        ~/RynsWorkspace

State:
  $STATE_DIR

Notes:
  The default invocation is the Rust server (ryns-code-mcp-rs), built
  with `cargo build` (debug, fast) into ryns-code-mcp-rs/target/debug;
  an existing release binary is preferred. stdin/stdout are passed
  directly to the MCP entrypoint; launcher logs go to stderr.
  The runner does not create a daemon for tunnel-client stdio usage.
EOF
}

read_version() {
  # Prefer the Rust crate version (the primary server); fall back to the
  # root package.json for legacy layouts.
  if [[ -f "$RUST_DIR/Cargo.toml" ]]; then
    awk -F'"' '/^version =/{print $2; exit}' "$RUST_DIR/Cargo.toml" \
      || sed -n 's/^version = "\(.*\)"/\1/p' "$RUST_DIR/Cargo.toml" | head -1
    return 0
  fi
  node -e 'const p=require(process.argv[1]); process.stdout.write(String(p.version || "unknown"))' "$PACKAGE_JSON"
}

# Resolves the binary the launcher will exec: Rust by default, legacy Go with
# -go. Prints the path; builds it first if missing/stale.
RUST_BIN=""
GO_MODE=false

resolve_rust_binary() {
  if [[ -x "$RUST_RELEASE_BIN" ]]; then
    printf '%s\n' "$RUST_RELEASE_BIN"
    return 0
  fi
  cd "$RUST_DIR"
  local stale_src
  stale_src="$(find "$RUST_DIR/src" -name '*.rs' -newer "$RUST_DEBUG_BIN" 2>/dev/null | head -1)"
  if [[ ! -x "$RUST_DEBUG_BIN" || "$RUST_DIR/Cargo.toml" -nt "$RUST_DEBUG_BIN" || -n "$stale_src" ]]; then
    log "building RynsCode MCP (Rust, debug) — first run takes a moment"
    cargo build
  fi
  cd "$ROOT"
  printf '%s\n' "$RUST_DEBUG_BIN"
}

resolve_go_binary() {
  cd "$ROOT"
  if [[ ! -x "$GO_BINARY" || "$LEGACY_GO_ENTRYPOINT" -nt "$GO_BINARY" || "$ROOT/go.mod" -nt "$GO_BINARY" || ( -f "$ROOT/go.sum" && "$ROOT/go.sum" -nt "$GO_BINARY" ) ]]; then
    if [[ ! -f "$ROOT/go.sum" ]]; then
      log "resolving Go module dependencies"
      go mod tidy
    fi
    log "building legacy Go MCP binary"
    go build -o "$GO_BINARY" ./legacy-go
  fi
  printf '%s\n' "$GO_BINARY"
}

pid_is_running() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1

  # Only consider a PID managed by this runner when its command line still
  # belongs to this MCP. Matches every binary the launcher can exec today
  # (Rust debug/release, legacy Go) plus a basename fallback so a rebuilt
  # target path still counts. Prevents killing an unrelated reused PID.
  local cmd
  cmd="$(ps -p "$pid" -o args= 2>/dev/null || true)"
  run_pid_cmd_matches "$cmd"
}

# Pure helper (self-testable via `./run --selftest-pid`): does a ps `args=`
# string belong to this MCP's known server binaries? The basename match
# covers the binary even if the crate dir moved.
run_pid_cmd_matches() {
  local cmd="$1"
  [[ "$cmd" == *"$ROOT/run"* \
    || "$cmd" == *"$ROOT/node_modules"* \
    || "$cmd" == *"$ROOT/src/index.ts"* \
    || "$cmd" == *"$RUST_DIR/target/"* \
    || "$cmd" == *"$STATE_DIR/ryns-go-legacy"* \
    || "$cmd" == *"ryns-code-mcp"* ]]
}

# Launcher self-test for the pure PID matcher (no server is started).
if [[ "${1:-}" == "--selftest-pid" ]]; then
  case1="$RUST_DIR/target/debug/ryns-code-mcp -port 8799"
  case2="$STATE_DIR/ryns-go-legacy"
  case3='some unrelated process --flag'
  if run_pid_cmd_matches "$case1" && run_pid_cmd_matches "$case2" \
    && ! run_pid_cmd_matches "$case3"; then
    echo "selftest-pid: ok"
    exit 0
  fi
  echo "selftest-pid: FAILED" >&2
  exit 1
fi

managed_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(tr -d '[:space:]' < "$PID_FILE")"
  pid_is_running "$pid" || return 1
  printf '%s\n' "$pid"
}

stop_managed() {
  local pid
  if ! pid="$(managed_pid)"; then
    rm -f "$PID_FILE"
    return 0
  fi

  log "stopping managed MCP process (pid $pid)"
  kill -TERM "$pid" 2>/dev/null || true

  for _ in {1..20}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done

  if kill -0 "$pid" 2>/dev/null; then
    log "managed process did not exit after SIGTERM; sending SIGKILL"
    kill -KILL "$pid" 2>/dev/null || true
  fi

  rm -f "$PID_FILE"
  printf '%s\n' 'stopped' > "$STATUS_FILE"
}

start_managed() {
  # This is intentionally not used by the normal stdio path. A managed PID
  # exists only when a future/background manager explicitly creates one.
  # Keeping this helper here makes --restart safe without daemonizing a
  # tunnel-client-owned stdio server.
  return 1
}

mkdir -p "$STATE_DIR"

COMMAND="run"
WORKSPACE_ARG_SET=false
PORT=""
GO_MODE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -go)
      GO_MODE=true
      shift
      ;;
    --workspace)
      [[ $# -ge 2 ]] || { echo "Missing value for --workspace" >&2; exit 2; }
      WORKSPACE="$2"
      WORKSPACE_ARG_SET=true
      shift 2
      ;;
    --port|-port)
      [[ $# -ge 2 ]] || { echo "Missing value for -port" >&2; exit 2; }
      PORT="$2"
      shift 2
      ;;
    --port=*|-port=*)
      PORT="${1#*=}"
      shift
      ;;
    --enable|--disable|--status|--restart|--version|--help)
      if [[ "$COMMAND" != "run" ]]; then
        echo "Only one command may be specified" >&2
        exit 2
      fi
      COMMAND="${1#--}"
      shift
      ;;
    -h)
      COMMAND="help"
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

# Resolve the workspace to an absolute path without requiring it to exist yet.
if [[ "$WORKSPACE" != /* ]]; then
  WORKSPACE="$(cd "$ROOT" && cd "$WORKSPACE" 2>/dev/null && pwd)" || {
    echo "Invalid workspace: $WORKSPACE" >&2
    exit 2
  }
fi

case "$COMMAND" in
  enable)
    printf '%s\n' enabled > "$ENABLED_FILE"
    printf '%s\n' enabled > "$STATUS_FILE"
    echo "enabled"
    echo "workspace: $WORKSPACE"
    echo "state: $STATE_DIR"
    ;;

  disable)
    stop_managed
    rm -f "$ENABLED_FILE"
    printf '%s\n' disabled > "$STATUS_FILE"
    echo "disabled"
    echo "workspace: $WORKSPACE"
    ;;

  status)
    if [[ -f "$ENABLED_FILE" ]]; then
      enabled_state="enabled"
    else
      enabled_state="disabled"
    fi

    pid=""
    if pid="$(managed_pid)"; then
      running_state="running"
    else
      running_state="not running"
      rm -f "$PID_FILE"
    fi

    version="$(read_version)"
    echo "enabled: $enabled_state"
    echo "running: $running_state"
    if [[ -n "$pid" ]]; then
      echo "pid: $pid"
    else
      echo "pid: -"
    fi
    echo "version: $version"
    echo "workspace: $WORKSPACE"
    echo "entrypoint: $RUST_DIR (Rust server)"
    ;;

  restart)
    if managed_pid >/dev/null 2>&1; then
      stop_managed
      if start_managed; then
        echo "restarted"
      else
        echo "no managed process was restarted"
      fi
    else
      rm -f "$PID_FILE"
      echo "no managed process to restart"
      echo "stdio-owned MCP was not started or duplicated"
    fi
    ;;

  version)
    read_version
    ;;

  help)
    usage
    ;;

  run)
    cd "$ROOT"
    export RYNS_WORKSPACE_ROOT="$WORKSPACE"

    # Do not daemonize, redirect, or wrap stdio. tunnel-client owns this
    # process and speaks MCP directly over stdin/stdout.
    local_server=""
    if $GO_MODE; then
      local_server="$(resolve_go_binary)"
      log "starting MCP (legacy Go): $local_server"
    else
      RUST_BIN="$(resolve_rust_binary)"
      local_server="$RUST_BIN"
      log "starting MCP (Rust): $local_server"
    fi
    if [[ -n "$PORT" ]]; then
      log "starting MCP HTTP on 127.0.0.1:$PORT: $local_server"
      exec "$local_server" -port "$PORT"
    fi
    log "starting MCP stdio: $local_server"
    exec "$local_server"
    ;;

  *)
    echo "Unknown command: $COMMAND" >&2
    usage >&2
    exit 2
    ;;
esac
